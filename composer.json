{
    "name": "swagnar/igapi",
    "description": "Instagram stories generator via Meta API",
    "autoload": {
        "psr-4": {
            "Swagnar\\Igapi\\": "src/"
        }
    },
    "require": {
        "php": ">=8.1",
        "ext-curl": "*",
        "ext-gd": "*",
        "ext-mbstring": "*",
        "vlucas/phpdotenv": "^5.6"
    },
    "scripts": {
        "admin": [
            "Composer\\Config::disableProcessTimeout",
            "php -d xdebug.mode=off -S 127.0.0.1:8080 admin/router.php"
        ]
    }
}
