# Skrzynka nadawcy (cPanel → Konta e-mail → Połącz urządzenia: serwer SMTP i port). Bez SMTP_HOST — mail() serwera
# SMTP_HOST=''
# SMTP_PORT=465
# SMTP_USER='igapi@swagnar.dev'
# SMTP_PASS=''
# ALERT_IN_DEBUG=true   # alerty także z runu w trybie debug — do sprawdzenia skrzynki
