APP_SECRET=''

# Produkcja: DEBUG=false (brak wpisu = tryb debug, bez publikacji)
DEBUG=true
# Opcjonalnie — domyślnie ../swagnar.dev/ig-stories i https://swagnar.dev/ig-stories
# PUBLIC_DIR='/home/vh13519/swagnar.dev/ig-stories'
# PUBLIC_URL='https://swagnar.dev/ig-stories'
# Document root strony swagnar.dev — run zapisuje tam data/today.json i rendery (domyślnie ../swagnar.dev; w DEBUG: web/)
# WEB_DIR='/home/vh13519/swagnar.dev'

# Otwarte Dane Kolejowe (PKP PLK) — opóźnienia pociągów. Darmowy klucz (pakiet Basic: 100 zapytań/h):
# wniosek na https://pdp-api.plk-sa.pl/ → potwierdź e-mail → aktywacja przez administratora w 3–5 dni roboczych
# PLK_API_KEY=

# Alerty mailem, gdy w runie coś się nie powiedzie (błąd modułu/źródła/publikacji, nieważny token, przerwany run)
