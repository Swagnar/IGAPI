                ]
            },
            { "type": "Spacer", "height": 10 },
            { "type": "Text", "text": "Ślad stacji · jasny odcinek — widać ją wtedy gołym okiem", "size": 16, "color": "#556688", "height": 30 },
            {
                "type": "HeatMap",
                "name": "Mapa przelotu",
                "points": [],
                "area": "poland",
                "land": "europe:!",
                "palette": [
                    [
                        0,
                        [0, 0, 0],
                        127
                    ]
                ],
                "view": "{{iss.view}}",
                "paths": "{{iss.paths}}"
            }
        ]
