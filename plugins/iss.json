{
    "label": "ISS nad Polską",
    "sources": ["iss"],
    "body": {
        "type": "Stack",
        "name": "ISS nad Polską",
        "children": [
            { "type": "Text", "text": "{{iss.headline}}", "size": 24, "color": "#8899CC", "height": 40 },
            { "type": "Text", "text": "{{iss.timeText}}", "size": 48, "font": "bold", "height": 70 },
            { "type": "Text", "text": "{{iss.subline}}", "size": 22, "color": "#7DD3FC", "height": 36 },
            {
                "type": "Stack",
